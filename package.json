{
  "name": "@hivemnd-ai/cli",
  "version": "0.3.0",
  "description": "Securely synchronize Hivemnd artifacts with local AI coding agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hivemnd-ai/cli.git"
  },
  "homepage": "https://github.com/hivemnd-ai/cli#readme",
  "bugs": {
    "url": "https://github.com/hivemnd-ai/cli/issues"
  },
  "type": "module",
  "bin": {
    "hivemnd": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
